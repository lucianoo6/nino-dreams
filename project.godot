; Engine configuration file.
; Godot 4.7 — GDScript

config_version=5

[application]

config/name="Once Upon a Pillow: Nino & Mel"
config/name_localized={
"pt_BR": "Era Uma Vez um Sonho",
"pt": "Era Uma Vez um Sonho"
}
config/description="Um menino sonha com o livro que leu antes de dormir. Mundos de feltro, lã e retalhos."
run/main_scene="res://scenes/menu/Quarto.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://scripts/core/game_state.gd"
Transicao="*res://scripts/core/transicao.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_cast=1

[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="sonhador"
3d_physics/layer_3="criaturas"
3d_physics/layer_4="coletaveis"

[physics]

3d/default_gravity=0.0

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.12, 0.1, 0.22, 1)
